SOURCE_POINTER","table":"sOricorioFormChangeTable","blob":"aa14e610cc9cbba49ea45a0d51edf0f293b1e525","parentBlob":"404f2304fc5f06386b1e66cbc07d9ca5694d185e"},{"parent":"SPECIES_ORICORIO_PAU","target":"SPECIES_ORICORIO_MEGA","requirement":"ITEM_ORICORIONITE","kind":"SOURCE_POINTER","table":"sOricorioFormChangeTable","blob":"aa14e610cc9cbba49ea45a0d51edf0f293b1e525","parentBlob":"404f2304fc5f06386b1e66cbc07d9ca5694d185e"},{"parent":"SPECIES_ORICORIO_SENSU","target":"SPECIES_ORICORIO_MEGA","requirement":"ITEM_ORICORIONITE","kind":"SOURCE_POINTER","table":"sOricorioFormChangeTable","blob":"aa14e610cc9cbba49ea45a0d51edf0f293b1e525","parentBlob":"404f2304fc5f06386b1e66cbc07d9ca5694d185e"},{"parent":"SPECIES_TATSUGIRI_CURLY","target":"SPECIES_TATSUGIRI_CURLY_MEGA","requirement":"ITEM_TATSUGIRINITE","kind":"SOURCE_POINTER","table":"sTatsugiriCurlyFormChangeTable","blob":"aa14e610cc9cbba49ea45a0d51edf0f293b1e525","parentBlob":"540d106b27a50eda617048b178148feb2ec2da02"},{"parent":"SPECIES_TATSUGIRI_DROOPY","target":"SPECIES_TATSUGIRI_DROOPY_MEGA","requirement":"ITEM_TATSUGIRINITE","kind":"SOURCE_POINTER","table":"sTatsugiriDroopyFormChangeTable","blob":"aa14e610cc9cbba49ea45a0d51edf0f293b1e525","parentBlob":"540d106b27a50eda617048b178148feb2ec2da02"},{"parent":"SPECIES_TATSUGIRI_STRETCHY","target":"SPECIES_TATSUGIRI_STRETCHY_MEGA","requirement":"ITEM_TATSUGIRINITE","kind":"SOURCE_POINTER","table":"sTatsugiriStretchyFormChangeTable","blob":"aa14e610cc9cbba49ea45a0d51edf0f293b1e525","parentBlob":"540d106b27a50eda617048b178148feb2ec2da02"}],"config":{"blob":"5866d243991d5c7b39397db5072ec1c86144abd7","lines":["#define P_GEN_7_POKEMON                  TRUE // Generation 7 Pokémon (SM, USUM, LGPE)","#define P_GEN_9_POKEMON                  TRUE // Generation 9 Pokémon (SV)","#define P_MEGA_EVOLUTIONS                TRUE","#define P_GEN_9_MEGA_EVOLUTIONS          P_MEGA_EVOLUTIONS // Mega Evolutions introduced in Z-A and its DLC","#define P_FAMILY_ORICORIO                P_GEN_7_POKEMON","#define P_FAMILY_TATSUGIRI               P_GEN_9_POKEMON"]},"productionAllowed":false,"sourcePin":"ff2640c12f6353706c4b3ad8f891e92ac52818fb","runner":"function probe(ff,forms,cfg){\nlet blocks=[];for(let f of ff){for(let m of f.content.matchAll(/\\[\\s*(SPECIES_[A-Z0-9_]+)\\s*\\]\\s*=\\s*\\{/g)){if(!/ORICORIO|TATSUGIRI|DUDUNSPARCE|DUDUDUNSPARCE|RATICATE_ALOLA|RATFIOSO|AEGISLASH.*REDUX/.test(m[1]))continue;let start=m.index+m[0].length,d=1,j=start;for(;j<f.content.length&&d;j++){if(f.content[j]===\"{\")d++;if(f.content[j]===\"}\")d--}let b=f.content.slice(start,j-1);blocks.push({species:m[1],blob:f.sha,path:f.path,pointers:[...b.matchAll(/\\.formChangeTable\\s*=\\s*(\\w+)/g)].map(x=>x[1]),mega:/\\.isMegaEvolution\\s*=\\s*TRUE/.test(b),evolutions:[...b.matchAll(/\\{\\s*(EVO_\\w+)\\s*,\\s*([^,{}]+)\\s*,\\s*(SPECIES_\\w+)\\s*[,}]/g)].map(x=>({method:x[1],param:x[2].trim(),target:x[3]}))})}}\nlet tables=[];for(let m of forms.content.matchAll(/(?:static\\s+)?const\\s+struct\\s+FormChange\\s+(\\w+)\\s*\\[\\s*\\]\\s*=\\s*\\{([\\s\\S]*?)\\n\\};/g)){if(!/Oricorio|Tatsugiri/.test(m[1]))continue;tables.push({name:m[1],blob:forms.sha,body:m[2]})}\nlet routes=[];for(let t of tables)for(let m of t.body.matchAll(/\\{\\s*FORM_CHANGE_BATTLE_MEGA_EVOLUTION_ITEM\\s*,\\s*(SPECIES_\\w+)\\s*,\\s*(ITEM_\\w+)\\s*\\}/g)){for(let b of blocks.filter(b=>!b.mega&&b.pointers.includes(t.name)))routes.push({parent:b.species,target:m[1],requirement:m[2],kind:\"SOURCE_POINTER\",table:t.name,blob:t.blob,parentBlob:b.blob})}\nif(routes.filter(r=>r.target===\"SPECIES_ORICORIO_MEGA\").length!==4)throw Error(\"Oricorio pointer count\");\nif(routes.filter(r=>/SPECIES_TATSUGIRI_(CURLY|DROOPY|STRETCHY)_MEGA/.test(r.target)).length!==3)throw Error(\"Tatsugiri pointer count\");\nreturn {schema:\"mercury-r26-focused-source-probe-v1\",sourceFiles:ff.map(({path,sha})=>({path,sha})),blocks,tables,routes,config:{blob:cfg.sha,lines:cfg.content.split(\"\\n\").filter(l=>/^#define P_(GEN_[79]_POKEMON|GEN_9_MEGA_EVOLUTIONS|MEGA_EVOLUTIONS|FAMILY_ORICORIO|FAMILY_TATSUGIRI)\\s/.test(l))},productionAllowed:false}}"}