":"EVO_LEVEL","param":"50","target":"SPECIES_GOODRA","conditions":[["IF_WEATHER","WEATHER_FOG"]],"index":1}],"contexts":3,"overlap":0,"none":1,"reached":["SPECIES_GOODRA"],"shadowed":[],"witness":null,"status":"SAME_TARGET_DISTINCT_PREDICATES"}],"cases":552,"counts":{"ORDERED_OVERLAP":1,"DISTINCT_PREDICATES":17,"UNCONDITIONAL_FIRST_MATCH_SHADOW":3,"SAME_TARGET_DISTINCT_PREDICATES":1},"assertions":6,"runner":"function run(auth,raw,engine){\nconst assert=(v,m)=>{if(!v)throw Error(m)};\nassert(engine.includes(\"If you have overlapping evolutions, put the ones you want to happen first on top of the list.\"),\"precedence\");\nfunction parse(r){let entries=[];for(let m of r.raw.matchAll(/\\{\\s*(EVO_\\w+)\\s*,\\s*([^,{}]+)\\s*,\\s*(SPECIES_\\w+)(?:\\s*,\\s*CONDITIONS\\(([\\s\\S]*?)\\))?\\s*\\}/g)){let conditions=[...(m[4]||\"\").matchAll(/\\{\\s*(IF_\\w+)(?:\\s*,\\s*([^{}]+?))?\\s*\\}/g)].map(q=>[q[1],q[2]?.trim()||null]);entries.push({method:m[1],param:m[2].trim(),target:m[3],conditions,index:entries.length})}return entries}\nconst source=new Map(raw.map(r=>[r.parent,{...r,entries:parse(r)}]));\nfunction evaluate(c,x){let [k,v]=c;switch(k){case\"IF_GENDER\":return x.gender===v;case\"IF_TIME\":return x.time===v;case\"IF_NOT_TIME\":return x.time!==v;case\"IF_HOLD_ITEM\":return x.item===v;case\"IF_IN_MAP\":return x.map===v;case\"IF_MIN_FRIENDSHIP\":return x.friend;case\"IF_KNOWS_MOVE_TYPE\":return x.fairy;case\"IF_KNOWS_MOVE\":return x.move;case\"IF_ATK_LT_DEF\":return x.atk<0;case\"IF_ATK_EQ_DEF\":return x.atk===0;case\"IF_ATK_GT_DEF\":return x.atk>0;case\"IF_PID_MODULO_100_GT\":return x.pid>Number(v);case\"IF_PID_MODULO_100_EQ\":return x.pid===Number(v);case\"IF_PID_UPPER_MODULO_10_GT\":return x.upper>Number(v);case\"IF_PID_UPPER_MODULO_10_LT\":return x.upper<Number(v);case\"IF_AMPED_NATURE\":return x.amped;case\"IF_LOW_KEY_NATURE\":return !x.amped;case\"IF_WEATHER\":return x.weather===v;default:throw Error(\"unknown \"+k)}}\nlet rows=[],cases=0;\nfor(let g of [...auth.conflicts,...auth.duplicates.filter(x=>x.key.startsWith(\"SPECIES_SLIGGOO|\"))]){let [parent,param,method]=g.key.split(\"|\"),s=source.get(parent);assert(s,\"missing parent \"+parent);let entries=s.entries.filter(e=>e.method===method&&e.param===param&&g.targets.includes(e.target));assert(entries.length===g.routes.length,\"source cardinality \"+g.key+\" \"+entries.length);let dims={};for(let c of entries.flatMap(e=>e.conditions)){let [k,v]=c;if(k===\"IF_GENDER\")dims.gender=[\"MON_MALE\",\"MON_FEMALE\",\"MON_GENDERLESS\"];else if(k===\"IF_TIME\"||k===\"IF_NOT_TIME\")dims.time=[\"TIME_DAY\",\"TIME_NIGHT\",\"TIME_EVENING\",\"TIME_MORNING\"];else if(k===\"IF_HOLD_ITEM\")dims.item=[...new Set([...dims.item||[\"ITEM_NONE\"],v])];else if(k===\"IF_IN_MAP\")dims.map=[...new Set([...dims.map||[\"OTHER\"],v])];else if(k===\"IF_MIN_FRIENDSHIP\")dims.friend=[false,true];else if(k===\"IF_KNOWS_MOVE_TYPE\")dims.fairy=[false,true];else if(k===\"IF_KNOWS_MOVE\")dims.move=[false,true];else if(k.startsWith(\"IF_ATK_\"))dims.atk=[-1,0,1];else if(k.startsWith(\"IF_PID_UPPER\"))dims.upper=Array.from({length:10},(_,i)=>i);else if(k.startsWith(\"IF_PID_MODULO\"))dims.pid=Array.from({length:100},(_,i)=>i);else if(k.endsWith(\"_NATURE\"))dims.amped=[true,false];else if(k===\"IF_WEATHER\")dims.weather=[...new Set([...dims.weather||[\"OTHER\"],v])];else throw Error(\"unhandled \"+k)}\nlet contexts=[{}];for(let [k,vs] of Object.entries(dims))contexts=contexts.flatMap(x=>vs.map(v=>({...x,[k]:v})));let reached=new Set(),overlap=0,none=0,witness=null;for(let x of contexts){let eligible=entries.filter(e=>e.conditions.every(c=>evaluate(c,x)));cases++;if(!eligible.length)none++;else reached.add(eligible[0].target);if(eligible.length>1){overlap++;witness??={context:x,eligible:eligible.map(e=>e.target)}}}\nlet status=g.targets.length===1?\"SAME_TARGET_DISTINCT_PREDICATES\":entries.every(e=>!e.conditions.length)?\"UNCONDITIONAL_FIRST_MATCH_SHADOW\":overlap?\"ORDERED_OVERLAP\":\"DISTINCT_PREDICATES\";rows.push({key:g.key,blob:s.blob,path:s.path,line:s.line,entries,contexts:contexts.length,overlap,none,reached:[...reached],shadowed:g.targets.filter(t=>!reached.has(t)),witness,status})}\nassert(rows.length===22,\"groups\");assert(rows.filter(x=>x.status===\"UNCONDITIONAL_FIRST_MATCH_SHADOW\").length===3,\"three shadows\");assert(rows.filter(x=>x.status===\"ORDERED_OVERLAP\").length===1,\"Eevee precedence\");assert(rows.filter(x=>x.status===\"DISTINCT_PREDICATES\").length===17,\"17 distinct\");assert(rows.filter(x=>x.status===\"SAME_TARGET_DISTINCT_PREDICATES\").length===1,\"Sliggoo\");return {rows,cases,counts:Object.fromEntries([...new Set(rows.map(x=>x.status))].map(s=>[s,rows.filter(x=>x.status===s).length])),assertions:6}}","limitations":["Host model enumerates symbolic condition domains, not native game execution; time/map/friendship guards and target enablement require native confirmation.","Sliggoo same target with rain/fog conditions is intentional alternative evidence, not redundant unconditional route.","Source guards and source order preserved in raw extracts. Eevee overlap follows first eligible source entry."],"productionAllowed":false}